# Optional environment for ytermusicd.service.
# Copy this file to ~/.config/ytermusicd/env and uncomment what you need.

# HTTP bind address/port (defaults: 127.0.0.1 and 8080).
# YTERMUSICD_BIND=127.0.0.1
# YTERMUSICD_PORT=8080

# Explicit headers file. By default the daemon uses
# ~/.config/ytermusicd/headers.txt with a legacy fallback.
# YTERMUSICD_HEADERS=/home/your-user/.config/ytermusicd/headers.txt

# Optional explicit config file.
# YTERMUSICD_CONFIG=/home/your-user/.config/ytermusicd/config.toml

# Log level (error, warn, info, debug, trace).
# RUST_LOG=info
